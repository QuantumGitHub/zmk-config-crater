#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define FN 3
#define DPlus 4

/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |   6   |  7    |  8    |  9   |   0   |  BSPC |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |   Y   |  U    |  I    |  O   |   P   |   \   |
// | CAPS  |  A  |  S  |  D   |  F   |  G   |                   |   H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |                   |   N   |  M    |  ,    |  .   |   /   | SHIFT |
// | CTRL  |  FN | META| ALT  | LOWER| SPACE|                   | ENTER | RAISE |  ALT  | MORE | CTRL  |  ++   |
                        bindings = <
   &kp GRAVE  &kp N1  &kp N2    &kp N3     &kp N4     &kp N5               &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp BSPC
   &kp TAB    &kp Q   &kp W     &kp E      &kp R      &kp T                &kp Y      &kp U     &kp I      &kp O     &kp P     &kp BSLH
   &kp CAPS   &kp A   &kp S     &kp D      &kp F      &kp G                &kp H      &kp J     &kp K      &kp L     &kp SEMI  &kp APOS
   &kp LSHFT  &kp Z   &kp X     &kp C      &kp V      &kp B                &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
   &kp LCTRL  &fn_key &kp LWIN  &kp LALT   &mo LOWER  &kp SPACE            &kp ENTER  &mo RAISE &kp RALT   &kp K_APP &kp RCTRL &mo DPlus
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;

        };
        lower_layer {
// -------------------------------------------------            ---------------------------------------------------
// |BT_CLR |  BT1  |  BT2  |  BT3  |  BT4  | MUTE  |            |VOL_DOWN|C_VOL_UP|       |       |       | BTCLR |
// |       |       |       |       |       |       |            |        |        |       |       |       |       |
// |  ESC  |       |       | LPAR  | RPAR  |       |            |        |  LBKT  | RBKT  |       |       |       |
// |       |       |       |       |       |       |            |        |        |       |       |       |       |
// |       |       |       |       |       |       |            |        |        |       |       |       |       |
                        bindings = <
   &bt BT_CLR &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &kp C_MUTE             &kp C_VOL_DN    &kp C_VOL_UP &trans   &trans    &trans    &bt BT_CLR
   &trans     &trans         &trans         &trans         &trans         &trans                 &trans          &trans       &trans   &trans    &trans    &trans
   &kp ESC    &trans         &trans         &kp LPAR       &kp RPAR       &trans                 &trans          &kp LBKT     &kp RBKT &trans    &trans    &trans
   &trans     &trans         &trans         &trans         &trans         &trans                 &trans          &trans       &trans   &trans    &trans    &trans
   &trans     &trans         &trans         &trans         &trans         &trans                 &trans          &trans       &trans   &trans    &trans    &trans
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |       |       |       |       |       |          |       |       |       |       |       |SFT_OF |
// |XPWR On|RGB_HUD|RGB_HUI|RGB_SAD|RGB_SAI|RGB_EFF|          |       |       |       |       |       |       |
// |XPWROff|RGB_BRD|RGB_BRI|RGB_TOG|       |       |          |   <-  |   V   |   ^   |   ->  |       |       |
// |       | RGB On|RGB OFF|       |       |       |          |       |       |   -   |   =   |       |       |
// |       |       |       |       |       |       |          |       |       |       |       |       |       |
                        bindings = <
   &trans            &trans          &trans          &trans          &trans          &trans                 &trans    &trans    &trans    &trans    &trans  &soft_off
   &ext_power EP_ON  &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF        &trans    &trans    &trans    &trans    &trans  &trans
   &ext_power EP_OFF &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_TOG &trans          &trans                 &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans  &trans
   &trans            &rgb_ug RGB_ON  &rgb_ug RGB_OFF &trans          &trans          &trans                 &trans    &trans    &kp MINUS &kp EQUAL &trans  &trans
   &trans            &trans          &trans          &trans          &trans          &trans                 &trans    &trans    &trans    &trans    &trans  &trans
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
        function_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |  F1   |  F2   |  F3   |  F4   |  F5   |          |  F6   |  F7   |   F8  |   F9  |  F10  |  DEL  |
// |       |  F11  |  F12  |  F13  |  F14  |  F15  |          |       |       |       |       |       |       |
// |  DEL  |       |       |       |       |       |          | home  | pg dn | pg up |  end  |       |       |
// |       |       |       |       |       |       |          |       |       |       |       |       |       |
// |       |       |       |       |       |       |          |       |       |       |       |       |       |
                        bindings = <
   &trans    &kp F1      &kp F2       &kp F3         &kp F4         &kp F5                 &kp F6    &kp F7    &kp F8    &kp F9      &kp F10 &kp DEL
   &trans    &kp F11     &kp F12      &kp F13        &kp F14        &kp F15                &trans    &trans    &trans    &trans      &trans  &trans
   &kp DEL   &trans      &trans       &trans         &trans         &trans                 &kp HOME  &kp PG_DN &kp PG_UP &kp END     &trans  &trans
   &trans    &trans      &trans       &trans         &trans         &trans                 &trans    &trans    &trans    &trans      &trans  &trans
   &trans    &trans      &trans       &trans         &trans         &trans                 &trans    &trans    &trans    &trans      &trans  &trans
                        >;

                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

    };
};
